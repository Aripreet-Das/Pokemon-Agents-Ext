{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile",
      "path": "extension/",
      "id": "npm: compile",
      "label": "npm: compile",
      "problemMatcher": [
        "$tsc-watch"
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": ["copy-webview"]
    },
    {
      "label": "copy-webview",
      "type": "shell",
      "command": "cp -r ${workspaceFolder}/webview-ui/dist ${workspaceFolder}/extension/dist/webview",
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": []
    }
  ]
}
